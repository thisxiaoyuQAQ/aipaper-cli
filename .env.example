# aipaper-cli environment template

# LLM providers. Fill only the providers you use.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=
GROK_API_KEY=

# Optional local or custom provider.
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# Optional enhanced academic search providers.
SERPAPI_KEY=
TAVILY_KEY=
EXA_KEY=
GOOGLE_SCHOLAR_PROXY_URL=

# Defaults used by local scripts or future TUI bootstrap.
AIPAPER_DEFAULT_LANGUAGE=zh-CN
AIPAPER_CITATION_STYLE=gbt7714
AIPAPER_OUTPUT_DIR=output/aipaper
